// Prisma Schema — Proyecto Semana 05
// Dominio: Estadio Deportivo — Concesiones

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Recurso secundario — categoría de producto (bebida, comida, snack, merchandising)
model Category {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  description String?
  concessions Concession[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// Recurso principal — producto vendido en las concesiones del estadio
model Concession {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String
  sku         String   @unique
  price       Float
  stock       Int      @default(0)
  available   Boolean  @default(true)
  category    Category @relation(fields: [categoryId], references: [id])
  categoryId  String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
